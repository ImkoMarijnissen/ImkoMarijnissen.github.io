{% comment %}
  Site override of al_folio_cv's templates/cv/languages.liquid.
  Restores the pre-v1 al-folio layout: languages in a two-column grid, the language name in the
  theme color with the fluency underneath (instead of "Language: Fluency" lines).
  The icon column is only emitted when an entry has a non-empty icon, so the text can be centered.
  Supports both formats like the upstream template:
  - RenderCV uses: name, summary (normal entries) or label, details (one-line entries)
  - JSONResume uses: language, fluency
{% endcomment %}

<div class="list-groups">
  {% for entry in entries %}
    {% assign lang_name = entry.name | default: entry.label | default: entry.language %}
    {% assign fluency = entry.summary | default: entry.details | default: entry.fluency %}
    <div class="list-group col-md-6">
      <table class="table-cv list-group-table">
        <tbody>
          <tr>
            {% if entry.icon and entry.icon != '' %}
              <td class="list-group-category-icon">
                <i class="{{ entry.icon }}"></i>
              </td>
            {% endif %}
            <td class="list-group-category">{{ lang_name }}</td>
          </tr>
          <tr>
            {% if entry.icon and entry.icon != '' %}<td></td>{% endif %}
            <td class="list-group-name">
              <b>{{ fluency }}</b>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  {% endfor %}
</div>
